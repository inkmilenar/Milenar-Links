{
  "rewrites": [
    { "source": "/manual", "destination": "https://milenar-manual.vercel.app/" },
    { "source": "/manual/:path*", "destination": "https://milenar-manual.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/manual",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/manual/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
